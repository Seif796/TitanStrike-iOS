# Godot 4 .gitignore
.godot/
*.translation
*.import
*.uid

# Xcode / iOS build outputs
build/
*.xcodeproj/
*.xcworkspace/
*.ipa
*.app
Payload/

# OS metadata
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# Local sPecrets & configs
server/ai_config.json
.env

# Local Godot binaries & temp zips
Godot_v*
godot*.zip

# Generated game packages & binaries
public/downloads/
server/public/downloads/
*.pck
*.apk
*.zip
*.key
*.token
server/data/*.key
server/data/*.json



